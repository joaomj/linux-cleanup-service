# Override these values in ~/.config/linux-cleanup-service/environment.
SESSION_RETENTION_DAYS=7
OPENCODE_DB_WARN_SIZE=2GiB
OPENCODE_BACKUP_MAX_SIZE=4GiB
OPENCODE_BACKUP_MAX_COUNT=2
OPENCODE_BACKUP_RETENTION_DAYS=14
OPENCODE_LOG_RETENTION_DAYS=14
UV_CACHE_MAX_SIZE=1GiB
BRAVE_CACHE_MAX_SIZE=2GiB
NPM_CACHE_WARN_SIZE=1GiB
JOURNAL_WARN_SIZE=100MiB
JOURNAL_SYSTEM_MAX_USE=80M
JOURNAL_SYSTEM_MAX_FILE_SIZE=8M
JOURNAL_RUNTIME_MAX_USE=16M
JOURNAL_RUNTIME_MAX_FILE_SIZE=8M
SQLITE_VACUUM_MIN_SIZE=128MiB
SQLITE_BUSY_TIMEOUT_SECONDS=30
COMMAND_TIMEOUT_SECONDS=900
OPENCODE_UPGRADE_ENABLED=true
OPENCODE_UPGRADE_METHOD=curl
