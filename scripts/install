#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
LIBEXEC_DIR="$HOME/.local/libexec/linux-cleanup-service"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/linux-cleanup-service"
SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
STATUS_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/linux-cleanup-service"

install -d -m 700 "$LIBEXEC_DIR" "$CONFIG_DIR" "$STATUS_DIR"
install -m 755 "$ROOT_DIR/src/config.py" "$LIBEXEC_DIR/config.py"
install -m 755 "$ROOT_DIR/src/sqlite_backup.py" "$LIBEXEC_DIR/sqlite_backup.py"
install -m 755 "$ROOT_DIR/src/cleanup.py" "$LIBEXEC_DIR/cleanup.py"
install -m 755 "$ROOT_DIR/src/status.py" "$LIBEXEC_DIR/status.py"
install -d -m 700 "$SYSTEMD_DIR"
install -m 644 "$ROOT_DIR/systemd/user/linux-cleanup.service" "$SYSTEMD_DIR/linux-cleanup.service"

if [ ! -e "$CONFIG_DIR/environment" ]; then
    install -m 600 "$ROOT_DIR/config/default.env" "$CONFIG_DIR/environment"
fi

BASHRC="$HOME/.bashrc"
MARKER="# linux-cleanup-service"
if [ ! -e "$BASHRC" ]; then
    install -m 644 /dev/null "$BASHRC"
fi
if ! grep -Fqx "$MARKER" "$BASHRC"; then
    {
        printf '\n%s\n' "$MARKER"
        printf 'if [ -f "$HOME/.local/libexec/linux-cleanup-service/bashrc-init.sh" ]; then . "$HOME/.local/libexec/linux-cleanup-service/bashrc-init.sh"; fi\n'
    } >> "$BASHRC"
fi
install -m 755 "$ROOT_DIR/shell/bashrc-init.sh" "$LIBEXEC_DIR/bashrc-init.sh"

systemctl --user daemon-reload

if command -v sudo >/dev/null 2>&1; then
    JOURNAL_TMP="$(mktemp)"
    SUDOERS_TMP="$(mktemp)"
    trap 'rm -f "$JOURNAL_TMP" "$SUDOERS_TMP"' EXIT
    /usr/bin/python3 "$ROOT_DIR/src/config.py" journal-config > "$JOURNAL_TMP"
    JOURNAL_VACUUM_SIZE="$(/usr/bin/python3 "$ROOT_DIR/src/config.py" journal-vacuum-size)"
    /usr/bin/python3 "$ROOT_DIR/src/config.py" sudoers-config > "$SUDOERS_TMP"
    visudo -cf "$SUDOERS_TMP"
    sudo install -D -m 644 "$JOURNAL_TMP" /etc/systemd/journald.conf.d/90-linux-cleanup-service.conf
    sudo install -D -m 440 -o root -g root "$SUDOERS_TMP" /etc/sudoers.d/90-linux-cleanup-service
    sudo systemctl restart systemd-journald
    sudo journalctl --rotate
    sudo journalctl --vacuum-size="$JOURNAL_VACUUM_SIZE"
else
    printf 'User files installed. Apply the root commands from README.md manually.\n'
fi

printf 'Installed linux-cleanup-service. Open a new Bash shell to start the daily job.\n'
