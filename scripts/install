#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

is_macos() { [[ "$(uname -s)" == "Darwin" ]]; }
is_linux() { [[ "$(uname -s)" == "Linux" ]]; }

if is_macos; then
    SERVICE_NAME="macos-cleanup-service"
    CONFIG_ROOT="$HOME/Library/Application Support"
    SERVICE_DIR="$HOME/Library/LaunchAgents"
    STATE_DIR="$CONFIG_ROOT/$SERVICE_NAME"
    INIT_FILENAME="zshrc-init.sh"
    LEGACY_CONFIG_DIR="$HOME/Library/Application Support/linux-cleanup-service"
    LEGACY_PLIST="$SERVICE_DIR/com.user.linux-cleanup-service.plist"
elif is_linux; then
    SERVICE_NAME="linux-cleanup-service"
    CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}"
    SERVICE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$SERVICE_NAME"
    INIT_FILENAME="bashrc-init.sh"
    LEGACY_CONFIG_DIR=""
    LEGACY_PLIST=""
else
    printf 'Unsupported platform: %s\n' "$(uname -s)"
    exit 1
fi

LIBEXEC_DIR="$HOME/.local/libexec/$SERVICE_NAME"
CONFIG_DIR="$CONFIG_ROOT/$SERVICE_NAME"

install -d -m 700 "$LIBEXEC_DIR" "$CONFIG_DIR" "$STATE_DIR"
install -m 755 "$ROOT_DIR/src/config.py" "$LIBEXEC_DIR/config.py"
install -m 755 "$ROOT_DIR/src/sqlite_backup.py" "$LIBEXEC_DIR/sqlite_backup.py"
install -m 755 "$ROOT_DIR/src/cleanup.py" "$LIBEXEC_DIR/cleanup.py"
install -m 755 "$ROOT_DIR/src/status.py" "$LIBEXEC_DIR/status.py"

if [ ! -e "$CONFIG_DIR/environment" ]; then
    if [ -n "$LEGACY_CONFIG_DIR" ] && [ -f "$LEGACY_CONFIG_DIR/environment" ]; then
        install -m 600 "$LEGACY_CONFIG_DIR/environment" "$CONFIG_DIR/environment"
    else
        ENV_TEMPLATE="$ROOT_DIR/config/default.env"
        if is_macos; then
            ENV_TEMPLATE="$ROOT_DIR/config/macos.env"
        fi
        install -m 600 "$ENV_TEMPLATE" "$CONFIG_DIR/environment"
    fi
fi

detect_shell_rc() {
    local shell_name
    shell_name="$(basename "${SHELL:-/bin/sh}")"
    case "$shell_name" in
        zsh)  printf '%s/.zshrc' "$HOME" ;;
        bash) printf '%s/.bashrc' "$HOME" ;;
        *)    printf '' ;;
    esac
}

SHELL_RC="$(detect_shell_rc)"
MARKER="# $SERVICE_NAME"
if [ -n "$SHELL_RC" ]; then
    if [ ! -e "$SHELL_RC" ]; then
        install -m 644 /dev/null "$SHELL_RC"
    fi
    if is_macos; then
        sed -i '' '/linux-cleanup-service/d' "$SHELL_RC"
    fi
    if ! grep -Fqx "$MARKER" "$SHELL_RC"; then
        {
            printf '\n%s\n' "$MARKER"
            printf 'if [ -f "$HOME/.local/libexec/%s/%s" ]; then . "$HOME/.local/libexec/%s/%s"; fi\n' \
                "$SERVICE_NAME" "$INIT_FILENAME" "$SERVICE_NAME" "$INIT_FILENAME"
        } >> "$SHELL_RC"
    fi
fi

if is_macos; then
    install -m 755 "$ROOT_DIR/macos/shell/$INIT_FILENAME" "$LIBEXEC_DIR/$INIT_FILENAME"
    PLIST="$SERVICE_DIR/com.user.macos-cleanup-service.plist"
    sed \
        -e "s|LIBEXEC_DIR_PLACEHOLDER|$LIBEXEC_DIR|g" \
        -e "s|STATE_DIR_PLACEHOLDER|$STATE_DIR|g" \
        "$ROOT_DIR/macos/launchd/user/com.user.macos-cleanup-service.plist" > "$PLIST"
    chmod 644 "$PLIST"
    if [ -n "$LEGACY_PLIST" ] && [ -f "$LEGACY_PLIST" ]; then
        launchctl unload "$LEGACY_PLIST" >/dev/null 2>&1 || true
        rm -f "$LEGACY_PLIST"
    fi
    rm -rf "$HOME/.local/libexec/linux-cleanup-service"
    launchctl unload "$PLIST" >/dev/null 2>&1 || true
    launchctl load "$PLIST"
    printf 'Installed %s (macOS). Daily job runs on first shell session.\n' "$SERVICE_NAME"
elif is_linux; then
    install -m 755 "$ROOT_DIR/shell/$INIT_FILENAME" "$LIBEXEC_DIR/$INIT_FILENAME"
    install -d -m 700 "$SERVICE_DIR"
    install -m 644 "$ROOT_DIR/systemd/user/linux-cleanup.service" "$SERVICE_DIR/linux-cleanup.service"
    systemctl --user daemon-reload
    if command -v sudo >/dev/null 2>&1; then
        JOURNAL_TMP="$(mktemp)"
        SUDOERS_TMP="$(mktemp)"
        trap 'rm -f "$JOURNAL_TMP" "$SUDOERS_TMP"' EXIT
        /usr/bin/python3 "$ROOT_DIR/src/config.py" journal-config > "$JOURNAL_TMP"
        JOURNAL_VACUUM_SIZE="$(/usr/bin/python3 "$ROOT_DIR/src/config.py" journal-vacuum-size)"
        /usr/bin/python3 "$ROOT_DIR/src/config.py" sudoers-config > "$SUDOERS_TMP"
        visudo -cf "$SUDOERS_TMP"
        sudo install -D -m 644 "$JOURNAL_TMP" /etc/systemd/journald.conf.d/90-linux-cleanup-service.conf
        sudo install -D -m 440 -o root -g root "$SUDOERS_TMP" /etc/sudoers.d/90-linux-cleanup-service
        sudo systemctl restart systemd-journald
        sudo journalctl --rotate
        sudo journalctl --vacuum-size="$JOURNAL_VACUUM_SIZE"
    else
        printf 'User files installed. Apply the root commands from README.md manually.\n'
    fi
    printf 'Installed %s (Linux). Open a new shell to start the daily job.\n' "$SERVICE_NAME"
fi
