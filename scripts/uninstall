#!/usr/bin/env bash
set -euo pipefail

is_macos() { [[ "$(uname -s)" == "Darwin" ]]; }
is_linux() { [[ "$(uname -s)" == "Linux" ]]; }

if is_macos; then
    SERVICE_NAME="macos-cleanup-service"
    PLIST="$HOME/Library/LaunchAgents/com.user.macos-cleanup-service.plist"
    LEGACY_PLIST="$HOME/Library/LaunchAgents/com.user.linux-cleanup-service.plist"
    for candidate in "$PLIST" "$LEGACY_PLIST"; do
        if [ -f "$candidate" ]; then
            launchctl unload "$candidate" >/dev/null 2>&1 || true
            rm -f "$candidate"
        fi
    done
elif is_linux; then
    SERVICE_NAME="linux-cleanup-service"
    systemctl --user stop linux-cleanup.service >/dev/null 2>&1 || true
    systemctl --user disable linux-cleanup.service >/dev/null 2>&1 || true
    systemctl --user daemon-reload
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/linux-cleanup.service"
    if command -v sudo >/dev/null 2>&1; then
        sudo rm -f /etc/systemd/journald.conf.d/90-linux-cleanup-service.conf
        sudo systemctl restart systemd-journald
    fi
else
    printf 'Unsupported platform: %s\n' "$(uname -s)"
    exit 1
fi

rm -rf "$HOME/.local/libexec/$SERVICE_NAME"
rm -rf "$HOME/.local/libexec/linux-cleanup-service"

detect_shell_rc() {
    local shell_name
    shell_name="$(basename "${SHELL:-/bin/sh}")"
    case "$shell_name" in
        zsh)  printf '%s/.zshrc' "$HOME" ;;
        bash) printf '%s/.bashrc' "$HOME" ;;
        *)    printf '' ;;
    esac
}

SHELL_RC="$(detect_shell_rc)"
if [ -n "$SHELL_RC" ] && [ -f "$SHELL_RC" ]; then
    if is_macos; then
        sed -i '' '/macos-cleanup-service/d; /linux-cleanup-service/d' "$SHELL_RC"
    else
        sed -i '/^# linux-cleanup-service$/,+1d' "$SHELL_RC"
    fi
fi

printf 'Removed %s code and unit. State and configuration remain.\n' "$SERVICE_NAME"
