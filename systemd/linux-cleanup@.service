[Unit]
Description=Daily storage cleanup for %i

[Service]
Type=oneshot
User=%i
Environment=HOME=/home/%i
Environment=USER=%i
Environment=LOGNAME=%i
Environment=XDG_CONFIG_HOME=/home/%i/.config
Environment=XDG_DATA_HOME=/home/%i/.local/share
Environment=XDG_STATE_HOME=/home/%i/.local/state
EnvironmentFile=-/home/%i/.config/linux-cleanup-service/environment
ExecStart=/usr/bin/python3 /usr/local/libexec/linux-cleanup-service/cleanup-vps.py
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ReadWritePaths=/home/%i /tmp/opencode
